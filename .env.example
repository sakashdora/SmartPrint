# Never commit .env or paste its contents into chat.
PORT=3000
# Vercel: set NODE_ENV=production and your exact HTTPS origin below.
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://RUNTIME_USER:PASSWORD@NEON_POOLER/DB?sslmode=verify-full
# Local operator only. Do not upload the migration owner login to Vercel.
MIGRATION_DATABASE_URL=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=
CRON_SECRET=
# Used only on the always-on shop PC, not on Vercel.
PROCESSOR_SECRET=
# Enable the real shop-PC pipeline during local development.
CONNECTOR_PROCESSING=true
# Admin provisioning is an explicit CLI operation, never a public API.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Razorpay online payments (optional; UPI QR & Counter Cash require no Razorpay keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shop PC Connector settings (used on the physical Windows PC running the connector)
SMARTPRINT_URL=http://localhost:3000
SMARTPRINT_DEVICE_TOKEN=
SMARTPRINT_PRINTER=
